# Copy to .env locally and fill only the values needed for the selected provider.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional local Ollama/OpenAI-compatible endpoint.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_LLM_MODEL=
OLLAMA_EMBEDDING_MODEL=

# Optional graph path; disabled by default.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Keep the original two-pass extraction path unless intentionally running the
# existing merged-extraction experiment.
MEMBLOCK_MERGED_EXTRACTION=0
